# Copy this file to ".env" next to docker-compose.yml and fill in the values.
# Compose reads it for the ${...} placeholders and, if the optional watchtower service is
# enabled, as that container's environment (env_file).

# --- Zocial ------------------------------------------------------------------
# Image built by the Gitea pipeline (.gitea/workflows/docker.yml), all lowercase:
#   :latest  production (main)      :dev  development (dev branch)
#   :1.12.0  a fixed release        :sha-<commit>  a single build (rollback point)
ZOCIAL_IMAGE=git.ztfr.eu/dome/zocial:latest
# Container name, must be unique on the NAS (e.g. zocial-dev for a second project)
ZOCIAL_CONTAINER_NAME=zocial
# Host port Zocial is served on
ZOCIAL_PORT=6666

# Instance to lock the client to (no instance input field shown on the login screen).
# Leave empty to allow users to log in to any instance.
SINGLE_INSTANCE=

# Base URL of a LibreTranslate-compatible translation backend.
# Empty = the Zocial-operated default (https://translate.zocial.social).
TRANSLATE_API=

# --- Watchtower (optional) ---------------------------------------------------
# Only if no Watchtower runs on this NAS yet: uncomment to start the bundled one.
# An existing Watchtower (e.g. from another project) already updates this container via its
# com.centurylinklabs.watchtower.enable label — then leave this commented out.
# COMPOSE_PROFILES=watchtower

# Only update containers carrying the label com.centurylinklabs.watchtower.enable=true
WATCHTOWER_LABEL_ENABLE=true
# Remove the old image after an update
WATCHTOWER_CLEANUP=true
# HTTP API (GET http://<nas>:8080/v1/update with "Authorization: Bearer <token>")
WATCHTOWER_HTTP_API_UPDATE=true
WATCHTOWER_HTTP_API_TOKEN=
# Keep polling the registry even though the HTTP API is enabled
WATCHTOWER_HTTP_API_PERIODIC_POLLS=true
# Seconds between registry checks
WATCHTOWER_POLL_INTERVAL=300
# Host port for the Watchtower HTTP API
WATCHTOWER_PORT=8080
# Gitea user + personal access token with "read:package". Only needed if the package is not
# public (the Zocial repository is public, so pulls work without credentials).
REPO_USER=
REPO_PASS=
